@using MyPortfolio.BusinessLayer.Dtos.CertificateCategoryDtos
@model List<ResultCertificateCategoryDto>
@{
    ViewData["Title"] = "Sertifika Kategorileri";
    Layout = "_AdminLayout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-layer-group me-2"></i> Sertifika Kategorileri</h6>
        <a href="/AdminCertificateCategory/CreateCertificateCategory" class="btn btn-primary btn-sm shadow-sm">
            <i class="fas fa-plus fa-sm me-1"></i> Yeni Kategori Ekle
        </a>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            Kategoriler iki seviyelidir: <strong>ana kategori</strong> (örn. Yazılım) ve onun altındaki
            <strong>alt kategoriler</strong> (örn. Front End). Bir sertifika birden fazla kategoride görünebilir.
            Sıra değeri küçük olan önce gelir.
        </p>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 70px;">İkon</th>
                        <th>Kategori</th>
                        <th style="width: 110px;">Tür</th>
                        <th style="width: 80px;">Sıra</th>
                        <th style="width: 120px;">Sertifika</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.IsMain ? "table-light" : "")">
                                <td class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                                    {
                                        <i class="@item.Icon fa-lg text-warning"></i>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsMain)
                                    {
                                        <span class="fw-bold">@item.Name</span>
                                        @if (item.ChildCount > 0)
                                        {
                                            <span class="text-muted small ms-1">(@item.ChildCount alt kategori)</span>
                                        }
                                    }
                                    else
                                    {
                                        @* Alt kategori: ana kategorisinin hemen altında girintili *@
                                        <span class="ms-4 text-muted"><i class="fas fa-level-up-alt fa-rotate-90 me-2"></i></span>@item.Name
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsMain)
                                    {
                                        <span class="badge bg-primary">Ana</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border">Alt</span>
                                    }
                                </td>
                                <td class="text-center">@item.DisplayOrder</td>
                                <td class="text-center">
                                    <span class="badge @(item.CertificateCount > 0 ? "bg-info" : "bg-secondary")">
                                        @item.CertificateCount
                                    </span>
                                </td>
                                <td class="text-center">
                                    <a href="/AdminCertificateCategory/UpdateCertificateCategory/@item.Id" class="btn btn-outline-info btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @* Silme POST + antiforgery token ile yapılır (CSRF koruması) *@
                                    <form method="post" action="/AdminCertificateCategory/DeleteCertificateCategory/@item.Id" asp-antiforgery="true" class="d-inline"
                                          onsubmit="return confirm('@item.Name kategorisini silmek istediğine emin misin?')">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" @(item.CanDelete ? "" : "disabled")
                                                title="@(item.CanDelete ? "Sil" : "Sertifikası veya alt kategorisi olan kategori silinemez")">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                <i class="fas fa-info-circle me-2"></i> Henüz bir kategori eklenmemiş. Sertifika ekleyebilmek için önce kategori oluştur.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
