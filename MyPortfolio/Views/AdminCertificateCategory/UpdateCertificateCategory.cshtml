@model MyPortfolio.BusinessLayer.Dtos.CertificateCategoryDtos.UpdateCertificateCategoryDto
@{
    ViewData["Title"] = "Kategoriyi Düzenle";
    Layout = "_AdminLayout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-white">
        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-edit me-2"></i> Kategoriyi Düzenle</h6>
    </div>
    <div class="card-body">
        <form method="post" novalidate>
            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Kategori Adı</label>
                <input type="text" asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small fw-bold"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Üst Kategori</label>
                <select asp-for="ParentId" asp-items="ViewBag.ParentCategories" class="form-select">
                    <option value="">— Yok, bu bir ana kategori —</option>
                </select>
                <span asp-validation-for="ParentId" class="text-danger small fw-bold"></span>
                <small class="text-muted">
                    Örn: "Front End" için üst kategori "Yazılım" olur. Sadece ana kategoriler listelenir; alt kategorinin altına kategori açılamaz.
                </small>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">İkon (Font Awesome sınıfı)</label>
                        <input type="text" asp-for="Icon" class="form-control" placeholder="Örn: fa fa-code" />
                        <span asp-validation-for="Icon" class="text-danger small fw-bold"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Sıra</label>
                        <input type="number" asp-for="DisplayOrder" class="form-control" min="0" />
                        <span asp-validation-for="DisplayOrder" class="text-danger small fw-bold"></span>
                    </div>
                </div>
            </div>

            <div class="text-end mt-4">
                <a href="/AdminCertificateCategory/Index" class="btn btn-secondary shadow-sm px-4 me-2">Vazgeç</a>
                <button type="submit" class="btn btn-primary shadow-sm px-5">
                    <i class="fas fa-save me-2"></i> Güncelle
                </button>
            </div>
        </form>
    </div>
</div>
