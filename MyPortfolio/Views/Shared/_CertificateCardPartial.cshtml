@model MyPortfolio.BusinessLayer.Dtos.CertificateDtos.ResultCertificateDto

@* Ortak sertifika kartı: ana sayfadaki "öne çıkanlar" ızgarası ve
   /Certificate sayfasındaki tam liste bu partial'ı kullanır (DRY).
   Görsel varsa (yüklenen resim ya da PDF'in otomatik önizlemesi) kartın üstünde gösterilir;
   yoksa kart büyük boş bir kutu yerine kompakt görünür. *@
<article class="certificate-card @(Model.HasVisual ? "" : "certificate-card--compact")">
    @if (Model.HasVisual)
    {
        <div class="certificate-media">
            @* .gallery-item sınıfı lightbox davranışını da getirir (bkz. site.js) *@
            <button type="button" class="gallery-item" data-full="@Model.DisplayImageUrl"
                    data-caption="@Model.Title" aria-label="@Model.Title sertifikasını büyüt">
                <img src="@Model.DisplayImageUrl" alt="@Model.Title sertifikası" loading="lazy" />
                <span class="gallery-zoom"><i class="fa fa-magnifying-glass-plus"></i></span>
            </button>
        </div>
    }

    <div class="certificate-body">
        @if (Model.Categories.Count > 0)
        {
            @* Sertifika birden fazla kategoride olabilir; kart kalabalıklaşmasın diye ilk ikisi + "+N" *@
            const int visibleLabelCount = 2;
            <div class="certificate-cats">
                @foreach (var category in Model.Categories.Take(visibleLabelCount))
                {
                    <span class="certificate-cat">
                        <i class="@(string.IsNullOrWhiteSpace(category.Icon) ? "fa fa-folder" : category.Icon)"></i>
                        @category.FullName
                    </span>
                }
                @if (Model.Categories.Count > visibleLabelCount)
                {
                    <span class="certificate-cat certificate-cat-more"
                          title="@string.Join(", ", Model.Categories.Skip(visibleLabelCount).Select(c => c.FullName))">
                        +@(Model.Categories.Count - visibleLabelCount)
                    </span>
                }
            </div>
        }

        <h4 class="certificate-title">@Model.Title</h4>

        <div class="certificate-meta">
            <span><i class="fa fa-building-columns"></i> @Model.Issuer</span>
            <span><i class="far fa-calendar-check"></i> @Model.IssueDateText</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="certificate-desc">@Model.Description</p>
        }

        @if (Model.IsPdf || !string.IsNullOrWhiteSpace(Model.CredentialUrl))
        {
            <div class="certificate-actions">
                @if (Model.IsPdf)
                {
                    @* PDF sayfa içinde gömülemiyor (CSP frame-ancestors / X-Frame-Options), yeni sekmede açılır *@
                    <a href="@Model.FileUrl" target="_blank" rel="noopener" class="certificate-action">
                        <i class="fa fa-file-pdf"></i> PDF
                    </a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CredentialUrl))
                {
                    <a href="@Model.CredentialUrl" target="_blank" rel="noopener" class="certificate-action">
                        <i class="fa fa-shield-halved"></i> Doğrula
                    </a>
                }
            </div>
        }
    </div>
</article>
