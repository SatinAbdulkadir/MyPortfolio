@model List<MyPortfolio.BusinessLayer.Dtos.CertificateDtos.ResultCertificateDto>

@* Öne çıkan sertifika yoksa bölüm hiç basılmaz: ana sayfada boş başlık durmasın *@
@if (Model != null && Model.Count > 0)
{
    <section id="certificates" class="section-padding">
        <div class="container">
            <div class="section-title">
                <span class="subtitle">BELGELERİM</span>
                <h2 class="title">Sertifikalar</h2>
            </div>

            <div class="certificates-grid">
                @foreach (var item in Model)
                {
                    @await Html.PartialAsync("_CertificateCardPartial", item)
                }
            </div>

            <div class="certificates-cta">
                <a href="/Certificate/Index" class="btn-hero btn-outline-hero">
                    Tüm Sertifikalarım <i class="fa fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </section>

    @await Html.PartialAsync("_LightboxPartial")
}
