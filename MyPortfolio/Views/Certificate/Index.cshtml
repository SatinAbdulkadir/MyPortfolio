@model MyPortfolio.WebUI.Models.CertificateListViewModel
@{
    ViewData["Title"] = "Sertifikalar";

    // SEO açıklaması gerçek içerikten üretilir: kaç sertifika, hangi kategoriler
    ViewData["Description"] = Model.TotalCount > 0
        ? $"Katıldığım eğitimler ve aldığım {Model.TotalCount} sertifika: {string.Join(", ", Model.Groups.Select(g => g.Category.Name))}. Belgeler ve doğrulama linkleriyle."
        : "Katıldığım eğitimler ve aldığım sertifikalar.";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="detail-page section-padding">
    <div class="container">

        @* Üst şerit: geri dön *@
        <a href="/#certificates" class="detail-back-link">
            <i class="fa fa-arrow-left"></i> Ana Sayfaya Dön
        </a>

        <div class="detail-header">
            <span class="subtitle">BELGELERİM</span>
            <h1 class="detail-title">Sertifikalar</h1>
            <p class="certificates-lead">
                Katıldığım eğitimler ve aldığım belgeler. Toplam @Model.TotalCount sertifika,
                @Model.Groups.Count ana kategori altında listeleniyor.
            </p>
        </div>

        @if (Model.Groups.Count == 0)
        {
            <div class="certificates-empty">
                <i class="fa fa-certificate"></i>
                <p>Henüz bir sertifika eklenmemiş.</p>
            </div>
        }
        else
        {
            @* Filtre çipleri ana kategorileri gösterir; JS ile grupları gösterip gizler (sayfa yenilenmez) *@
            <div class="cert-filter-bar" role="group" aria-label="Kategori filtresi">
                <button type="button" class="cert-filter-chip active" data-filter="all">
                    Tümü <span class="cert-filter-count">@Model.TotalCount</span>
                </button>
                @foreach (var group in Model.Groups)
                {
                    <button type="button" class="cert-filter-chip" data-filter="@group.Category.Id">
                        @if (!string.IsNullOrWhiteSpace(group.Category.Icon))
                        {
                            <i class="@group.Category.Icon"></i>
                        }
                        @group.Category.Name
                        <span class="cert-filter-count">@group.DistinctCount</span>
                    </button>
                }
            </div>

            @foreach (var group in Model.Groups)
            {
                <div class="cert-group" data-category="@group.Category.Id">
                    <h2 class="cert-group-title">
                        <i class="@(string.IsNullOrWhiteSpace(group.Category.Icon) ? "fa fa-folder" : group.Category.Icon)"></i>
                        @group.Category.Name
                    </h2>

                    @* Ana kategoriye doğrudan bağlı sertifikalar, alt bölümlerden önce *@
                    @if (group.Certificates.Count > 0)
                    {
                        <div class="certificates-grid">
                            @foreach (var item in group.Certificates)
                            {
                                @await Html.PartialAsync("_CertificateCardPartial", item)
                            }
                        </div>
                    }

                    @foreach (var sub in group.SubGroups)
                    {
                        <div class="cert-subgroup">
                            <h3 class="cert-subgroup-title">
                                @if (!string.IsNullOrWhiteSpace(sub.Category.Icon))
                                {
                                    <i class="@sub.Category.Icon"></i>
                                }
                                @sub.Category.Name
                                <span class="cert-filter-count">@sub.Certificates.Count</span>
                            </h3>

                            <div class="certificates-grid">
                                @foreach (var item in sub.Certificates)
                                {
                                    @await Html.PartialAsync("_CertificateCardPartial", item)
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</section>

@await Html.PartialAsync("_LightboxPartial")

@section Scripts {
    <script>
        // Kategori filtresi — yalnızca bu sayfada gerekli olduğu için site.js yerine burada
        document.addEventListener("DOMContentLoaded", function () {
            var chips = Array.prototype.slice.call(document.querySelectorAll('.cert-filter-chip'));
            var groups = Array.prototype.slice.call(document.querySelectorAll('.cert-group'));

            if (chips.length === 0) return;

            chips.forEach(function (chip) {
                chip.addEventListener('click', function () {
                    var filter = chip.dataset.filter;

                    chips.forEach(function (c) { c.classList.remove('active'); });
                    chip.classList.add('active');

                    groups.forEach(function (group) {
                        var visible = filter === 'all' || group.dataset.category === filter;
                        group.hidden = !visible;
                    });
                });
            });
        });
    </script>
}
