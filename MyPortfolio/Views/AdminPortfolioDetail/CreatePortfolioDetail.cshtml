@model MyPortfolio.BusinessLayer.Dtos.PortfolioDetailDtos.CreatePortfolioDetailDto
@{
    ViewData["Title"] = "Proje Detayı Ekle";
    Layout = "_AdminLayout";
}

<div class="card shadow mb-4">
    <div class="card-header py-3 bg-white">
        <h6 class="m-0 fw-bold text-primary">
            <i class="fas fa-plus-circle me-2"></i> Proje Detayı Ekle
            @if (ViewBag.PortfolioTitle != null)
            {
                <span class="badge bg-info text-dark ms-2">@ViewBag.PortfolioTitle</span>
            }
        </h6>
    </div>
    <div class="card-body">
        @* DİKKAT: enctype eklemezsek dosyalar null gelir! *@
        <form method="post" enctype="multipart/form-data" novalidate>
            <input type="hidden" asp-for="PortfolioId" />

            <div class="mb-3">
                <label class="form-label fw-bold">Detay Açıklaması</label>
                <textarea asp-for="DetailDescription" rows="8" class="form-control"
                          placeholder="Projeyi detaylıca anlat: bu oyun/uygulama nedir, bu projede neler denendi, hangi problemler çözüldü..."></textarea>
                <span asp-validation-for="DetailDescription" class="text-danger small fw-bold"></span>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Kullanılan Teknolojiler</label>
                <input type="text" asp-for="Technologies" class="form-control" placeholder="Örn: Unity, C#, Blender" />
                <span asp-validation-for="Technologies" class="text-danger small fw-bold"></span>
                <small class="text-muted">Virgülle ayırarak yazın; sitede rozet (çip) olarak görünür.</small>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Video Dosyası (mp4)</label>
                        <input type="file" asp-for="VideoFile" class="form-control" accept="video/mp4,video/webm" />
                        <span asp-validation-for="VideoFile" class="text-danger small fw-bold"></span>
                        <small class="text-muted">Kısa bir tanıtım videosu yükleyin (isteğe bağlı, en fazla 100 MB).</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label class="form-label fw-bold">veya Video Linki (YouTube vb.)</label>
                        <input type="url" asp-for="VideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=..." />
                        <span asp-validation-for="VideoUrl" class="text-danger small fw-bold"></span>
                        <small class="text-muted">Dosya yüklerseniz bu alan yok sayılır. İkisi de boşsa video bölümü sitede görünmez.</small>
                    </div>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">Galeri Resimleri</label>
                <input type="file" asp-for="GalleryFiles" class="form-control" accept="image/*" multiple />
                <span asp-validation-for="GalleryFiles" class="text-danger small fw-bold"></span>
                <small class="text-muted">Ctrl tuşuyla birden fazla resim seçebilirsiniz (isteğe bağlı).</small>
            </div>

            <div class="text-end mt-4">
                <a href="/AdminPortfolioDetail/Index" class="btn btn-secondary shadow-sm px-4 me-2">Vazgeç</a>
                <button type="submit" class="btn btn-primary shadow-sm px-5">
                    <i class="fas fa-save me-2"></i> Detayı Kaydet
                </button>
            </div>
        </form>
    </div>
</div>
