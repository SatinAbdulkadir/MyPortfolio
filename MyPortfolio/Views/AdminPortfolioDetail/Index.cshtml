@model List<MyPortfolio.WebUI.Models.AdminPortfolioDetailRowViewModel>
@{
    ViewData["Title"] = "Proje Detayları";
    Layout = "_AdminLayout";
    int count = 0;
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-file-alt me-2"></i> Proje Detay Sayfaları</h6>
        <small class="text-muted">Detay eklemek için önce "Projelerim" bölümünden proje oluşturun.</small>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th style="width: 100px;">Görsel</th>
                        <th>Proje Adı</th>
                        <th>Detay Durumu</th>
                        <th class="text-center">Önizleme</th>
                        <th style="width: 180px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td>@count</td>
                                <td>
                                    <img src="@item.Portfolio.ImageUrl" class="rounded shadow-sm"
                                         style="width: 80px; height: 50px; object-fit: cover;"
                                         alt="Project" />
                                </td>
                                <td class="fw-bold">@item.Portfolio.Title</td>
                                <td>
                                    @if (item.Detail != null)
                                    {
                                        <span class="badge bg-success"><i class="fas fa-check me-1"></i> Detay Mevcut</span>
                                        @if (!string.IsNullOrEmpty(item.Detail.VideoUrl))
                                        {
                                            <span class="badge bg-info text-dark ms-1"><i class="fas fa-video me-1"></i> Video</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary"><i class="fas fa-minus me-1"></i> Detay Yok</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="/Portfolio/Detail/@item.Portfolio.Id" target="_blank" class="btn btn-link btn-sm text-decoration-none">
                                        <i class="fas fa-external-link-alt"></i> Sayfayı Gör
                                    </a>
                                </td>
                                <td class="text-center">
                                    @if (item.Detail != null)
                                    {
                                        <a href="/AdminPortfolioDetail/UpdatePortfolioDetail/@item.Detail.Id" class="btn btn-outline-warning btn-sm">
                                            <i class="fas fa-edit"></i> Düzenle
                                        </a>
                                        @* Silme POST + antiforgery token ile yapılır (CSRF koruması) *@
                                        <form method="post" action="/AdminPortfolioDetail/DeletePortfolioDetail/@item.Detail.Id" asp-antiforgery="true" class="d-inline"
                                              onsubmit="return confirm('Bu projenin detay sayfasını silmek istediğine emin misin reis?')">
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a href="/AdminPortfolioDetail/CreatePortfolioDetail?portfolioId=@item.Portfolio.Id" class="btn btn-primary btn-sm shadow-sm">
                                            <i class="fas fa-plus me-1"></i> Detay Ekle
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">
                                <i class="fas fa-layer-group d-block mb-2 fa-3x"></i>
                                Henüz bir proje eklenmemiş. Önce "Projelerim" bölümünden proje ekleyin.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
