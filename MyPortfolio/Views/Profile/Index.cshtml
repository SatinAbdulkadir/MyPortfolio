@model MyPortfolio.WebUI.Models.AccountSettingsViewModel
@inject Microsoft.Extensions.Options.IOptions<Microsoft.AspNetCore.Identity.IdentityOptions> IdentityOptions
@{
    ViewData["Title"] = "Hesap Güvenliği";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    // Şifre kuralları elle yazılmaz, Program.cs'teki Identity ayarlarından okunur (tek kaynak)
    var pw = IdentityOptions.Value.Password;
    var rules = new List<string> { $"En az {pw.RequiredLength} karakter" };
    if (pw.RequireUppercase) rules.Add("En az bir büyük harf (A-Z)");
    if (pw.RequireLowercase) rules.Add("En az bir küçük harf (a-z)");
    if (pw.RequireDigit) rules.Add("En az bir rakam (0-9)");
    if (pw.RequireNonAlphanumeric) rules.Add("En az bir sembol (! ? * _ gibi)");

    var isDefaultUserName = string.Equals(Model.CurrentUserName, "admin", StringComparison.OrdinalIgnoreCase);
}

<div class="mb-4">
    <h4 class="fw-bold mb-1"><i class="fas fa-user-lock text-primary me-2"></i>Hesap Güvenliği</h4>
    <p class="text-muted mb-0">Panele giriş yaptığın kullanıcı adını ve şifreni buradan değiştirebilirsin.</p>
</div>

@if (TempData["AccountMessage"] is string message)
{
    <div class="alert alert-success d-flex align-items-center shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> @message
    </div>
}

<div class="row g-4">
    @* KULLANICI ADI *@
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-id-badge me-2"></i>Kullanıcı Adı</h6>
            </div>
            <div class="card-body">
                <p class="mb-3">
                    Şu anki kullanıcı adın:
                    <span class="badge bg-dark fs-6 ms-1">@Model.CurrentUserName</span>
                </p>

                @if (isDefaultUserName)
                {
                    <div class="alert alert-warning small py-2">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        <strong>admin</strong> en çok tahmin edilen kullanıcı adıdır. Değiştirirsen giriş için
                        hem kullanıcı adının hem şifrenin bilinmesi gerekir.
                    </div>
                }

                <form method="post" asp-action="ChangeUserName" novalidate>
                    <div class="mb-3">
                        <label class="form-label fw-bold" asp-for="UserNameForm.NewUserName">Yeni kullanıcı adı</label>
                        <input type="text" asp-for="UserNameForm.NewUserName" class="form-control" autocomplete="username" placeholder="Örn: abdulkadir.satin" />
                        <span asp-validation-for="UserNameForm.NewUserName" class="text-danger small fw-bold"></span>
                        <div class="form-text">Harf, rakam ve <code>- . _ @@ +</code> kullanılabilir. Türkçe karakter ve boşluk kullanılamaz.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold" asp-for="UserNameForm.CurrentPassword">Mevcut şifren</label>
                        <div class="input-group">
                            <input type="password" asp-for="UserNameForm.CurrentPassword" class="form-control" autocomplete="current-password" placeholder="Onay için şu anki şifren" />
                            <button type="button" class="btn btn-outline-secondary js-toggle-password" aria-label="Şifreyi göster"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="UserNameForm.CurrentPassword" class="text-danger small fw-bold"></span>
                    </div>

                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="fas fa-save me-1"></i> Kullanıcı Adını Değiştir
                    </button>
                </form>
            </div>
        </div>
    </div>

    @* ŞİFRE *@
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3 bg-white">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-key me-2"></i>Şifre</h6>
            </div>
            <div class="card-body">
                <form method="post" asp-action="ChangePassword" novalidate>
                    <div class="mb-3">
                        <label class="form-label fw-bold" asp-for="PasswordForm.CurrentPassword">Mevcut şifren</label>
                        <div class="input-group">
                            <input type="password" asp-for="PasswordForm.CurrentPassword" class="form-control" autocomplete="current-password" />
                            <button type="button" class="btn btn-outline-secondary js-toggle-password" aria-label="Şifreyi göster"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="PasswordForm.CurrentPassword" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" asp-for="PasswordForm.NewPassword">Yeni şifre</label>
                        <div class="input-group">
                            <input type="password" asp-for="PasswordForm.NewPassword" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary js-toggle-password" aria-label="Şifreyi göster"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="PasswordForm.NewPassword" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" asp-for="PasswordForm.ConfirmPassword">Yeni şifre (tekrar)</label>
                        <div class="input-group">
                            <input type="password" asp-for="PasswordForm.ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <button type="button" class="btn btn-outline-secondary js-toggle-password" aria-label="Şifreyi göster"><i class="fas fa-eye"></i></button>
                        </div>
                        <span asp-validation-for="PasswordForm.ConfirmPassword" class="text-danger small fw-bold"></span>
                    </div>

                    <div class="bg-light border rounded p-3 mb-4 small">
                        <div class="fw-bold mb-1"><i class="fas fa-list-check me-1"></i>Yeni şifre kuralları</div>
                        <ul class="mb-0 ps-3">
                            @foreach (var rule in rules)
                            {
                                <li>@rule</li>
                            }
                        </ul>
                    </div>

                    <button type="submit" class="btn btn-primary px-4 shadow-sm">
                        <i class="fas fa-save me-1"></i> Şifreyi Değiştir
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.GetCspNonce()">
        // Göz ikonu: şifreyi yazarken kontrol edebilmek için göster/gizle
        document.querySelectorAll('.js-toggle-password').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('input');
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.querySelector('i').className = show ? 'fas fa-eye-slash' : 'fas fa-eye';
                btn.setAttribute('aria-label', show ? 'Şifreyi gizle' : 'Şifreyi göster');
            });
        });
    </script>
}
