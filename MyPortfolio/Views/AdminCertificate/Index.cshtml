@using MyPortfolio.BusinessLayer.Dtos.CertificateDtos
@model List<ResultCertificateDto>
@{
    ViewData["Title"] = "Sertifika Listesi";
    Layout = "_AdminLayout";
    int count = 0;
}

<div class="card shadow mb-4">
    <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white">
        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-certificate me-2"></i> Sertifikalarım</h6>
        <div>
            <a href="/AdminCertificateCategory/Index" class="btn btn-outline-secondary btn-sm shadow-sm me-1">
                <i class="fas fa-layer-group fa-sm me-1"></i> Kategoriler
            </a>
            <a href="/AdminCertificate/CreateCertificate" class="btn btn-primary btn-sm shadow-sm">
                <i class="fas fa-plus fa-sm me-1"></i> Yeni Sertifika Ekle
            </a>
        </div>
    </div>
    <div class="card-body">
        <p class="text-muted small">
            <i class="fas fa-star text-warning me-1"></i> işaretli sertifikalar ana sayfadaki "öne çıkanlar" bölümünde görünür;
            tamamı ise Sertifikalar sayfasında listelenir.
        </p>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle" width="100%" cellspacing="0">
                <thead class="table-light text-center">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th style="width: 90px;">Dosya</th>
                        <th>Sertifika</th>
                        <th>Kategori</th>
                        <th style="width: 130px;">Tarih</th>
                        <th style="width: 90px;">Öne Çıkan</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td class="text-center fw-bold">@count</td>
                                <td class="text-center">
                                    @if (item.HasImage)
                                    {
                                        <img src="@item.FileUrl" alt="@item.Title" class="img-thumbnail" style="width: 70px; height: 50px; object-fit: cover;" />
                                    }
                                    else if (item.IsPdf)
                                    {
                                        <a href="@item.FileUrl" target="_blank" rel="noopener" title="PDF'i aç">
                                            <i class="fas fa-file-pdf fa-2x text-danger"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Title</div>
                                    <div class="text-muted small">@item.Issuer</div>
                                    @if (!string.IsNullOrWhiteSpace(item.CredentialUrl))
                                    {
                                        <a href="@item.CredentialUrl" target="_blank" rel="noopener" class="small">
                                            <i class="fas fa-link me-1"></i>Doğrulama linki
                                        </a>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary">
                                        @if (!string.IsNullOrWhiteSpace(item.CategoryIcon))
                                        {
                                            <i class="@item.CategoryIcon me-1"></i>
                                        }
                                        @item.CategoryName
                                    </span>
                                </td>
                                <td class="text-center">@item.IssueDateText</td>
                                <td class="text-center">
                                    @if (item.IsFeatured)
                                    {
                                        <i class="fas fa-star text-warning" title="Ana sayfada görünüyor"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star text-muted" title="Ana sayfada görünmüyor"></i>
                                    }
                                </td>
                                <td class="text-center">
                                    <a href="/AdminCertificate/UpdateCertificate/@item.Id" class="btn btn-outline-info btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @* Silme POST + antiforgery token ile yapılır (CSRF koruması) *@
                                    <form method="post" action="/AdminCertificate/DeleteCertificate/@item.Id" asp-antiforgery="true" class="d-inline"
                                          onsubmit="return confirm('Bu sertifikayı silmek istediğine emin misin?')">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="fas fa-info-circle me-2"></i> Henüz bir sertifika eklenmemiş.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
